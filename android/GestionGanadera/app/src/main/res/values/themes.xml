<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.GestionGanadera" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/verde_primario</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorPrimaryContainer">@color/verde_contenedor</item>
        <item name="colorOnPrimaryContainer">@color/verde_sobre_contenedor</item>
        <item name="colorSecondary">@color/tierra</item>
        <item name="colorOnSecondary">@color/blanco</item>
        <item name="colorSecondaryContainer">@color/tierra_contenedor</item>
        <item name="colorOnSecondaryContainer">@color/tierra_sobre_contenedor</item>
        <item name="colorTertiary">@color/oliva</item>
        <item name="colorSurface">@color/superficie</item>
        <item name="colorOnSurface">@color/texto</item>
        <item name="colorSurfaceVariant">@color/superficie_variante</item>
        <item name="colorOnSurfaceVariant">@color/texto_secundario</item>
        <item name="colorOutline">@color/contorno</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/fondo</item>
        <item name="android:statusBarColor">@color/verde_primario</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="materialButtonStyle">@style/Widget.Ganaderia.Button</item>
    </style>

    <!-- RNF-06: botones grandes -->
    <style name="Widget.Ganaderia.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.Ganaderia.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/superficie</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/superficie_variante</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Barra superior verde: flecha, menú de desbordamiento e íconos en blanco -->
    <style name="ThemeOverlay.Ganaderia.Toolbar" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="colorControlNormal">@color/blanco</item>
        <item name="colorOnSurface">@color/blanco</item>
        <item name="colorOnSurfaceVariant">@color/blanco</item>
        <item name="actionMenuTextColor">@color/blanco</item>
    </style>

    <style name="Texto.Titulo" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/texto</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Texto.Detalle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/texto_secundario</item>
    </style>

</resources>
